<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="idleText" type="String"><default></default></entry>
    <entry name="idleTextUseDefault" type="Bool"><default>true</default></entry>
    <entry name="notFoundText" type="String"><default></default></entry>
    <entry name="notFoundTextUseDefault" type="Bool"><default>true</default></entry>
    <entry name="noLyricText" type="String"><default></default></entry>
    <entry name="noLyricTextUseDefault" type="Bool"><default>true</default></entry>
    <entry name="networkErrorText" type="String"><default></default></entry>
    <entry name="networkErrorTextUseDefault" type="Bool"><default>true</default></entry>
    <!-- The four *TextUseDefault entries above are retained only so version
         0/1 instances can be migrated into this shared version 2 policy. -->
    <entry name="emptyTextUseDefault" type="Bool"><default>true</default></entry>
    <entry name="textConfigVersion" type="Int"><default>0</default></entry>
    <!-- DESIGN.md decision 76. 0 until ThemePolicy.migrateConfiguration has
         run once; see that function for what the first run copies. -->
    <entry name="themeConfigVersion" type="Int"><default>0</default></entry>

    <entry name="desktopPlateMode" type="String"><default>ksvg</default></entry>
    <entry name="desktopSolidColor" type="String"><default>#99000000</default></entry>
    <entry name="desktopTextColor" type="String"><default>#fffaf5</default></entry>
    <entry name="desktopStroke" type="Bool"><default>false</default></entry>
    <entry name="desktopStrokeColor" type="String"><default>#cc000000</default></entry>
    <!-- Empty means follow the Plasma font (Kirigami.Theme.defaultFont), which
         is what every instance did before this key existed, so an upgraded
         instance renders exactly as before. A stored name that is no longer
         installed renders in the Plasma font too, but is kept as is, so the
         font comes back once it is reinstalled and plasmashell restarted. -->
    <entry name="desktopFontFamily" type="String"><default></default></entry>
    <entry name="desktopFontSize" type="Int"><default>34</default></entry>
    <entry name="desktopFontWeight" type="Int"><default>700</default></entry>
    <entry name="desktopOverflow" type="String"><default>fit</default></entry>
    <entry name="desktopAnimation" type="String"><default>slide</default></entry>
    <entry name="desktopShowTranslation" type="Bool"><default>true</default></entry>
    <!-- desktopShowTranslation keeps its original meaning, "show the second
         line"; desktopSecondLineSource says which line that is. Two keys
         rather than one three-way string so an existing instance's on/off
         choice carries over with no migration. -->
    <entry name="desktopSecondLineSource" type="String"><default>translation</default></entry>
    <entry name="desktopSecondLineColorEnabled" type="Bool"><default>false</default></entry>
    <!-- Matches the alpha the second line has always derived from the text
         colour, so turning this on changes nothing until the colour is
         actually edited. -->
    <entry name="desktopSecondLineColor" type="String"><default>#adfffaf5</default></entry>
    <entry name="desktopLineHeight" type="Int"><default>125</default></entry>

    <!-- Off restores DESIGN.md decision 38's wakeup profile exactly: it empties
         the word Repeater's model and the particle layer, which is also what
         stops the per-frame FrameAnimation. Since decision 77 that clock runs
         while (effectiveWords.length > 0 || lyricPositionMs < lyric.particlesAliveUntilMs)
         && Playing && (panelMode || shouldBeVisible): with this entry on, it
         no longer stops the moment the line without words (an interlude, a
         blank line, the end of the track) begins, but runs on until the last
         particle of the lines before has faded, up to about 2 s after
         them; desktopWordParticles off drops that extension. No combination
         of the colour and effect settings below substitutes for this entry:
         three identical colours neutralise the look, but the clock keeps
         running because nothing can tell it the colours match.
         desktopWordByWordSynthetic below does not weaken this claim: it is only
         ever consulted while this entry is true (see LyricsView.qml's
         effectiveWords), so turning this off silences the synthesized clock
         along with the real one no matter what the synthetic entry holds. What
         it does change, independently of this entry, is the previously-free
         case: a track whose document carries no real word timings used to
         leave this clock permanently disarmed at zero cost; with the synthetic
         entry on, such a track now arms it too. -->
    <entry name="desktopWordByWord" type="Bool"><default>true</default></entry>
    <!-- DESIGN.md's synthetic word-by-word decision: fabricates a per-character
         timeline, evenly dividing the line's own duration by character count,
         for a document whose lyric source provides no word timings at all.
         Document-level, not line-level (see LyricSource::currentSyntheticWords):
         a document with real words on even one line never synthesizes on any
         of its other lines. Off by default, unlike desktopWordByWord above
         (which is opt-out): this one is opt-in, because it spends the wakeup
         budget decision 38 exists to protect on tracks that cost nothing today. -->
    <entry name="desktopWordByWordSynthetic" type="Bool"><default>false</default></entry>
    <entry name="desktopWordUnsungColor" type="String"><default>#8cfffaf5</default></entry>
    <entry name="desktopWordActiveColor" type="String"><default>#e6fffaf5</default></entry>
    <entry name="desktopWordSungColor" type="String"><default>#c4fffaf5</default></entry>
    <!-- No panel counterpart for the two lift keys, the same asymmetry
         decision 40 settled for desktopHideAnimationMs: a panel sets the
         widget's height itself, so a lifted word is clipped and the setting
         would be a control that visibly does nothing. -->
    <entry name="desktopWordLift" type="Bool"><default>true</default></entry>
    <entry name="desktopWordLiftPercent" type="Int"><default>14</default></entry>
    <entry name="desktopWordBrightness" type="Bool"><default>true</default></entry>
    <entry name="desktopWordBrightnessPercent" type="Int"><default>60</default></entry>
    <entry name="desktopWordBlurGlow" type="Bool"><default>false</default></entry>
    <!-- DESIGN.md decision 77. With desktopWordParticleColorEnabled off, the
         particles take desktopWordActiveColor at full opacity.
         desktopWordParticleColor defaults to that key's default at full
         opacity, so turning desktopWordParticleColorEnabled on leaves the
         particles as they were only while desktopWordActiveColor is still at
         its default; once that has been edited, the particles take
         desktopWordParticleColor instead. -->
    <entry name="desktopWordParticles" type="Bool"><default>true</default></entry>
    <entry name="desktopWordParticleColorEnabled" type="Bool"><default>false</default></entry>
    <entry name="desktopWordParticleColor" type="String"><default>#fffaf5</default></entry>

    <entry name="desktopShowTrackInfo" type="Bool"><default>true</default></entry>
    <entry name="desktopTrackInfoLayout" type="String"><default>single</default></entry>
    <!-- True: track info uses whatever family the lyrics actually render in,
         and desktopTrackInfoFontFamily is ignored. False: that key applies,
         with the same empty-means-Plasma-font rule as desktopFontFamily. Two
         keys, like desktopSecondLineColorEnabled/desktopSecondLineColor,
         rather than one string with a reserved marker value. -->
    <entry name="desktopTrackInfoFontSameAsLyrics" type="Bool"><default>true</default></entry>
    <entry name="desktopTrackInfoFontFamily" type="String"><default></default></entry>
    <entry name="desktopTrackInfoFontSize" type="Int"><default>19</default></entry>
    <entry name="desktopTrackInfoFontWeight" type="Int"><default>400</default></entry>
    <entry name="desktopTrackInfoColor" type="String"><default>#b3fffaf5</default></entry>
    <entry name="desktopTrackInfoStroke" type="Bool"><default>false</default></entry>
    <entry name="desktopTrackInfoStrokeColor" type="String"><default>#cc000000</default></entry>
    <entry name="desktopTrackInfoOverflow" type="String"><default>fit</default></entry>

    <!-- DESIGN.md decision 40: deliberately asymmetric with the panel group
         below. desktopHideAnimationMs has no panel counterpart because the
         panel never animates, it hides via Plasmoid.status, not opacity,
         so a panel copy would be a SpinBox that visibly does nothing. -->
    <entry name="desktopAutoHide" type="Bool"><default>false</default></entry>
    <entry name="desktopHideDelaySec" type="Int"><default>5</default></entry>
    <entry name="desktopHideAnimationMs" type="Int"><default>1000</default></entry>
    <entry name="desktopHideNonMusic" type="Bool"><default>true</default></entry>

    <!-- DESIGN.md decision 76: auto follows whether the Plasma style, which
         draws the plate and the panel, is light or dark; light and dark pin
         one set. The desktopXxx keys above are the dark set; each
         desktopLightXxx below is the light copy of the key with the same
         suffix, read instead of it while the light set is in effect.
         ThemePolicy.js lists the suffixes that have a copy. The light
         defaults put warm near black ink, at the dark set's alphas, on the
         plate a light style draws; the solid plate and outline turn white.
         Brightening is off because it fades a word toward opaque white,
         which on dark ink makes the word being sung the palest one on the
         line. Particles are off for the same kind of reason: in the colour
         of dark ink they are specks on the plate, not points of light. -->
    <entry name="desktopThemeMode" type="String"><default>auto</default></entry>
    <entry name="desktopLightPlateMode" type="String"><default>ksvg</default></entry>
    <entry name="desktopLightSolidColor" type="String"><default>#99ffffff</default></entry>
    <entry name="desktopLightTextColor" type="String"><default>#1f1b16</default></entry>
    <entry name="desktopLightStroke" type="Bool"><default>false</default></entry>
    <entry name="desktopLightStrokeColor" type="String"><default>#ccffffff</default></entry>
    <entry name="desktopLightFontFamily" type="String"><default></default></entry>
    <entry name="desktopLightFontSize" type="Int"><default>34</default></entry>
    <entry name="desktopLightFontWeight" type="Int"><default>700</default></entry>
    <entry name="desktopLightOverflow" type="String"><default>fit</default></entry>
    <entry name="desktopLightAnimation" type="String"><default>slide</default></entry>
    <entry name="desktopLightShowTranslation" type="Bool"><default>true</default></entry>
    <entry name="desktopLightSecondLineSource" type="String"><default>translation</default></entry>
    <entry name="desktopLightSecondLineColorEnabled" type="Bool"><default>false</default></entry>
    <entry name="desktopLightSecondLineColor" type="String"><default>#ad1f1b16</default></entry>
    <entry name="desktopLightLineHeight" type="Int"><default>125</default></entry>
    <entry name="desktopLightWordByWord" type="Bool"><default>true</default></entry>
    <entry name="desktopLightWordByWordSynthetic" type="Bool"><default>false</default></entry>
    <entry name="desktopLightWordUnsungColor" type="String"><default>#8c1f1b16</default></entry>
    <entry name="desktopLightWordActiveColor" type="String"><default>#e61f1b16</default></entry>
    <entry name="desktopLightWordSungColor" type="String"><default>#c41f1b16</default></entry>
    <entry name="desktopLightWordLift" type="Bool"><default>true</default></entry>
    <entry name="desktopLightWordLiftPercent" type="Int"><default>14</default></entry>
    <entry name="desktopLightWordBrightness" type="Bool"><default>false</default></entry>
    <entry name="desktopLightWordBrightnessPercent" type="Int"><default>60</default></entry>
    <entry name="desktopLightWordBlurGlow" type="Bool"><default>false</default></entry>
    <entry name="desktopLightWordParticles" type="Bool"><default>false</default></entry>
    <entry name="desktopLightWordParticleColorEnabled" type="Bool"><default>false</default></entry>
    <entry name="desktopLightWordParticleColor" type="String"><default>#1f1b16</default></entry>
    <entry name="desktopLightTrackInfoColor" type="String"><default>#b31f1b16</default></entry>
    <entry name="desktopLightTrackInfoStroke" type="Bool"><default>false</default></entry>
    <entry name="desktopLightTrackInfoStrokeColor" type="String"><default>#ccffffff</default></entry>

    <entry name="panelPlateMode" type="String"><default>ksvg</default></entry>
    <entry name="panelWidth" type="Int"><default>280</default></entry>
    <entry name="panelSolidColor" type="String"><default>#99000000</default></entry>
    <entry name="panelTextColor" type="String"><default>#fffaf5</default></entry>
    <entry name="panelStroke" type="Bool"><default>false</default></entry>
    <entry name="panelStrokeColor" type="String"><default>#cc000000</default></entry>
    <!-- See desktopFontFamily's comment above; same rule, panel copy. -->
    <entry name="panelFontFamily" type="String"><default></default></entry>
    <entry name="panelFontSize" type="Int"><default>16</default></entry>
    <entry name="panelFontWeight" type="Int"><default>400</default></entry>
    <entry name="panelOverflow" type="String"><default>fit</default></entry>
    <entry name="panelAnimation" type="String"><default>fade</default></entry>
    <entry name="panelShowTranslation" type="Bool"><default>false</default></entry>
    <entry name="panelSecondLineSource" type="String"><default>translation</default></entry>
    <entry name="panelSecondLineColorEnabled" type="Bool"><default>false</default></entry>
    <entry name="panelSecondLineColor" type="String"><default>#adfffaf5</default></entry>
    <entry name="panelLineHeight" type="Int"><default>125</default></entry>

    <entry name="panelWordByWord" type="Bool"><default>true</default></entry>
    <!-- See desktopWordByWordSynthetic's comment above; same decision, panel copy. -->
    <entry name="panelWordByWordSynthetic" type="Bool"><default>false</default></entry>
    <entry name="panelWordUnsungColor" type="String"><default>#8cfffaf5</default></entry>
    <entry name="panelWordActiveColor" type="String"><default>#e6fffaf5</default></entry>
    <entry name="panelWordSungColor" type="String"><default>#c4fffaf5</default></entry>
    <entry name="panelWordBrightness" type="Bool"><default>true</default></entry>
    <entry name="panelWordBrightnessPercent" type="Int"><default>60</default></entry>
    <entry name="panelWordBlurGlow" type="Bool"><default>false</default></entry>
    <!-- See desktopWordParticles's comment above; same decision, panel copy.
         Unlike the lift keys these do have one: in a panel the particle layer
         is clipped to the widget's own bounds, and the particles show within
         them. -->
    <entry name="panelWordParticles" type="Bool"><default>true</default></entry>
    <entry name="panelWordParticleColorEnabled" type="Bool"><default>false</default></entry>
    <entry name="panelWordParticleColor" type="String"><default>#fffaf5</default></entry>

    <entry name="panelShowTrackInfo" type="Bool"><default>false</default></entry>
    <entry name="panelTrackInfoLayout" type="String"><default>single</default></entry>
    <!-- See desktopTrackInfoFontSameAsLyrics's comment above; panel copy. -->
    <entry name="panelTrackInfoFontSameAsLyrics" type="Bool"><default>true</default></entry>
    <entry name="panelTrackInfoFontFamily" type="String"><default></default></entry>
    <entry name="panelTrackInfoFontSize" type="Int"><default>12</default></entry>
    <entry name="panelTrackInfoFontWeight" type="Int"><default>400</default></entry>
    <entry name="panelTrackInfoColor" type="String"><default>#b3fffaf5</default></entry>
    <entry name="panelTrackInfoStroke" type="Bool"><default>false</default></entry>
    <entry name="panelTrackInfoStrokeColor" type="String"><default>#cc000000</default></entry>
    <entry name="panelTrackInfoOverflow" type="String"><default>fit</default></entry>

    <entry name="panelAutoHide" type="Bool"><default>false</default></entry>
    <entry name="panelHideDelaySec" type="Int"><default>5</default></entry>
    <entry name="panelHideNonMusic" type="Bool"><default>true</default></entry>

    <!-- See the desktopLight block above; same decision, panel copy, minus
         the two lift keys the panel does not have. -->
    <entry name="panelThemeMode" type="String"><default>auto</default></entry>
    <entry name="panelLightPlateMode" type="String"><default>ksvg</default></entry>
    <entry name="panelLightSolidColor" type="String"><default>#99ffffff</default></entry>
    <entry name="panelLightTextColor" type="String"><default>#1f1b16</default></entry>
    <entry name="panelLightStroke" type="Bool"><default>false</default></entry>
    <entry name="panelLightStrokeColor" type="String"><default>#ccffffff</default></entry>
    <entry name="panelLightFontFamily" type="String"><default></default></entry>
    <entry name="panelLightFontSize" type="Int"><default>16</default></entry>
    <entry name="panelLightFontWeight" type="Int"><default>400</default></entry>
    <entry name="panelLightOverflow" type="String"><default>fit</default></entry>
    <entry name="panelLightAnimation" type="String"><default>fade</default></entry>
    <entry name="panelLightShowTranslation" type="Bool"><default>false</default></entry>
    <entry name="panelLightSecondLineSource" type="String"><default>translation</default></entry>
    <entry name="panelLightSecondLineColorEnabled" type="Bool"><default>false</default></entry>
    <entry name="panelLightSecondLineColor" type="String"><default>#ad1f1b16</default></entry>
    <entry name="panelLightLineHeight" type="Int"><default>125</default></entry>
    <entry name="panelLightWordByWord" type="Bool"><default>true</default></entry>
    <entry name="panelLightWordByWordSynthetic" type="Bool"><default>false</default></entry>
    <entry name="panelLightWordUnsungColor" type="String"><default>#8c1f1b16</default></entry>
    <entry name="panelLightWordActiveColor" type="String"><default>#e61f1b16</default></entry>
    <entry name="panelLightWordSungColor" type="String"><default>#c41f1b16</default></entry>
    <entry name="panelLightWordBrightness" type="Bool"><default>false</default></entry>
    <entry name="panelLightWordBrightnessPercent" type="Int"><default>60</default></entry>
    <entry name="panelLightWordBlurGlow" type="Bool"><default>false</default></entry>
    <entry name="panelLightWordParticles" type="Bool"><default>false</default></entry>
    <entry name="panelLightWordParticleColorEnabled" type="Bool"><default>false</default></entry>
    <entry name="panelLightWordParticleColor" type="String"><default>#1f1b16</default></entry>
    <entry name="panelLightTrackInfoColor" type="String"><default>#b31f1b16</default></entry>
    <entry name="panelLightTrackInfoStroke" type="Bool"><default>false</default></entry>
    <entry name="panelLightTrackInfoStrokeColor" type="String"><default>#ccffffff</default></entry>
  </group>
</kcfg>
